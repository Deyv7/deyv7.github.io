---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

const email = encodeURIComponent(profile.email);
const providers = [
  { name: 'Gmail', initial: 'G', href: `https://mail.google.com/mail/?view=cm&fs=1&to=${email}` },
  { name: 'Outlook', initial: 'O', href: `https://outlook.live.com/mail/0/deeplink/compose?to=${email}` },
];
---

<dialog
  id="email-dialog"
  class="email-dialog"
  data-email-dialog
  data-email={profile.email}
  aria-labelledby="email-dialog-title"
  aria-describedby="email-dialog-description"
>
  <div class="email-panel t-modal">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="mb-2 text-xs font-semibold tracking-[0.14em] text-brand uppercase">Contato</p>
        <h2 id="email-dialog-title" class="text-2xl font-bold tracking-tight">Enviar e-mail</h2>
      </div>
      <button type="button" class="btn btn-ghost btn-square -mt-1 -mr-1" data-email-close aria-label="Fechar modal">
        <Icon name="close" class="size-5" />
      </button>
    </div>

    <p id="email-dialog-description" class="mt-3 text-sm text-muted">Escolha como prefere entrar em contato.</p>
    <label for="email-dialog-address" class="sr-only">Endereço de e-mail</label>
    <input id="email-dialog-address" class="email-address" type="text" value={profile.email} readonly data-email-address />

    <div class="mt-5 grid gap-2">
      {providers.map((provider) => (
        <a href={provider.href} class="email-option" target="_blank" rel="noopener noreferrer" data-email-provider>
          <span class="email-option-icon font-bold" aria-hidden="true">{provider.initial}</span>
          <span class="flex-1">
            <span class="block font-semibold">Abrir {provider.name}</span>
            <span class="block text-xs text-muted">Escrever em uma nova aba</span>
          </span>
          <Icon name="external" class="size-4 shrink-0 text-muted" />
        </a>
      ))}
      <button type="button" class="email-option" data-email-copy>
        <span class="email-option-icon" aria-hidden="true"><Icon name="copy" class="size-5" /></span>
        <span class="flex-1">
          <span class="block font-semibold">Copiar e-mail</span>
          <span class="block text-xs text-muted">Usar onde preferir</span>
        </span>
      </button>
    </div>
    <p class="mt-3 min-h-5 text-sm text-brand" role="status" aria-live="polite" aria-atomic="true" data-email-status></p>
  </div>
</dialog>

<script>
  import '../scripts/email-dialog';
</script>

<style is:global>
  :root {
    --modal-open-dur: 250ms;
    --modal-close-dur: 150ms;
    --modal-scale: 0.96;
    --modal-scale-close: 0.96;
    --modal-ease: cubic-bezier(0.22, 1, 0.36, 1);
  }
</style>

<style>
  .email-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 1.25rem;
    border: 0;
    background: transparent;
    color: var(--color-base-content);
    overscroll-behavior: contain;
  }

  .email-dialog[open] { display: grid; place-items: center; }
  .email-dialog::backdrop { background: rgb(0 0 0 / 0.55); }

  .email-panel {
    width: min(100%, 26rem);
    max-height: calc(100dvh - 2.5rem);
    overflow-y: auto;
    padding: 1.5rem;
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-box);
    background: var(--color-base-100);
    box-shadow: 0 24px 72px rgb(0 0 0 / 0.2);
  }

  .email-address {
    width: 100%;
    margin-top: 1rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-field);
    background: var(--color-base-200);
    font-size: 0.9375rem;
  }

  .email-option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.875rem;
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-field);
    background: var(--color-base-100);
    text-align: left;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: border-color 150ms ease, background-color 150ms ease;
  }

  .email-option-icon { display: grid; width: 2rem; flex-shrink: 0; place-items: center; }
  .email-option:active { background: var(--color-base-200); }
  .email-option:focus-visible,
  .email-address:focus-visible { outline: 2px solid var(--color-link); outline-offset: 3px; }

  @media (hover: hover) and (pointer: fine) {
    .email-option:hover { background: var(--color-base-200); border-color: var(--color-base-content); }
  }

  .t-modal {
    transform-origin: center;
    transform: scale(var(--modal-scale));
    opacity: 0;
    pointer-events: none;
    transition:
      transform var(--modal-open-dur) var(--modal-ease),
      opacity   var(--modal-open-dur) var(--modal-ease);
    will-change: transform, opacity;
  }
  .t-modal.is-open {
    transform: scale(1);
    opacity: 1;
    pointer-events: auto;
  }
  .t-modal.is-closing {
    transform: scale(var(--modal-scale-close));
    opacity: 0;
    pointer-events: none;
    transition:
      transform var(--modal-close-dur) var(--modal-ease),
      opacity   var(--modal-close-dur) var(--modal-ease);
  }

  .email-dialog[data-instant] .t-modal { transition: none !important; }
  @media (prefers-reduced-motion: reduce) {
    .t-modal { transition: none !important; }
    .email-option { transition: none; }
  }
</style>
