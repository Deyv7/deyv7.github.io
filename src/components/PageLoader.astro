---
import brainLoading from '../assets/brain-loading.svg?raw';
import { profile } from '../data/profile';
import { getLocale } from '../lib/i18n';
const english = getLocale(Astro.url.pathname) === 'en-US';
---

<div
  id="page-loader"
  class="abertura"
  role="status"
  aria-live="polite"
  aria-label={english ? 'Loading page' : 'Carregando página'}
  transition:persist="page-loader"
  transition:animate="none"
>
  <div class="abertura-conteudo">
    <div class="abertura-cerebro" set:html={brainLoading} />
    <p class="abertura-nome">{profile.displayName}</p>
    <p class="abertura-papel" data-loading-label>{english ? 'Loading portfolio' : 'Carregando o portfólio'}</p>
  </div>
</div>

<script>
  import { getLocale, localizePath, navigationLabels } from '../lib/i18n';
  import { loadingEvent } from '../lib/loading-state';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const desktop = window.matchMedia('(min-width: 1024px)');
  // Abertura da primeira visita: o cérebro fica um pouco mais e depois os
  // ícones do menu aparecem no centro e voam para dentro do cérebro do canto.
  const ESPERA_VOO_MS = 1200;
  const VITRINE_MS = 1400;
  const VOO_MS = 800;
  // Atraso antes de a tela aparecer (o mesmo 1 s do CSS) e o tempo que ela
  // fica, no mínimo, depois de aparecer.
  const APARECE_APOS_MS = 1000;
  const MINIMO_VISIVEL_MS = 300;
  let active = false;
  let started = performance.now();
  let revision = 0;
  let timeout: number;
  let closing: number;
  let stopping: number;
  let animationFrame: number;
  let announcedBusy: boolean | undefined;
  let tracks: { path: SVGPathElement; frames: string[]; duration: number; frame: number }[] = [];

  const renderFrame = (now: number) => {
    for (const track of tracks) {
      // O carimbo do requestAnimationFrame pode ser anterior ao início da animação,
      // o que gerava índice negativo e um 'd' inválido no <path>.
      const decorrido = Math.max(0, now - started);
      const duracao = track.duration > 0 ? track.duration : 2002;
      const frame = reducedMotion.matches
        ? 0
        : Math.min(track.frames.length - 1, Math.floor(((decorrido % duracao) / duracao) * track.frames.length));
      if (frame === track.frame) continue;
      const d = track.frames[frame];
      if (!d) continue;
      track.path.setAttribute('d', d);
      track.frame = frame;
    }
    if (!reducedMotion.matches) animationFrame = requestAnimationFrame(renderFrame);
  };

  const restartAnimation = () => {
    cancelAnimationFrame(animationFrame);
    // Reproduz os próprios quadros do arquivo, sem depender do relógio SMIL
    // de um SVG que o ClientRouter remove e reinsere durante a navegação.
    tracks = tracks.filter((track) => track.path.isConnected);
    for (const animation of document.querySelectorAll('#page-loader animate[attributeName="d"]')) {
      const path = animation.parentElement as unknown as SVGPathElement;
      const frames = animation.getAttribute('values')?.split(';') ?? [];
      if (frames.length) tracks.push({
        path,
        frames,
        duration: parseFloat(animation.getAttribute('dur') ?? '2.002') * 1000,
        frame: -1,
      });
      animation.remove();
    }
    renderFrame(performance.now());
  };
  const setBusy = (busy: boolean) => {
    document.documentElement.toggleAttribute('data-loading', busy);
    document.querySelector('#conteudo')?.setAttribute('aria-busy', String(busy));
    if (announcedBusy !== busy) {
      announcedBusy = busy;
      document.dispatchEvent(new CustomEvent(loadingEvent, { detail: { active: busy } }));
    }
  };

  const hide = () => {
    active = false;
    window.clearTimeout(timeout);
    window.clearTimeout(closing);
    setBusy(false);
    const current = revision;
    stopping = window.setTimeout(() => {
      if (current === revision && !active) cancelAnimationFrame(animationFrame);
    }, reducedMotion.matches ? 0 : 180);
  };

  const show = (pathname = location.pathname) => {
    revision++;
    window.clearTimeout(closing);
    window.clearTimeout(timeout);
    window.clearTimeout(stopping);
    started = performance.now();
    active = true;
    const locale = getLocale(pathname);
    const path = localizePath(pathname, 'pt-BR');
    const labels = navigationLabels[locale];
    const page = labels[path as keyof typeof labels];
    const label = document.querySelector('[data-loading-label]');
    if (label) label.textContent = locale === 'en-US'
      ? `Loading ${page ?? 'project'}`
      : `Carregando ${page ?? 'projeto'}`;
    document.querySelector('#page-loader')?.setAttribute('aria-label', locale === 'en-US' ? 'Loading page' : 'Carregando página');
    setBusy(true);
    restartAnimation();
    // Libera a interface mesmo se a navegação for interrompida ou falhar.
    timeout = window.setTimeout(hide, 8000);
    return revision;
  };

  /**
   * Fim da primeira carga da visita, no desktop: o cérebro e o nome saem, os
   * ícones do menu aparecem grandes no centro e depois voam, um atrás do
   * outro, para dentro do cérebro do canto, que guarda a sidebar recolhida.
   * Enquanto isso o fundo esmaece e a página entra por baixo. Devolve false
   * quando não há para onde voar, e aí vale a saída de sempre.
   */
  const flyIcons = () => {
    const root = document.documentElement;
    root.removeAttribute('data-voo');
    const loader = document.querySelector<HTMLElement>('#page-loader');
    const brain = document.querySelector<HTMLElement>('[data-cerebro-menu]');
    const sources = Array.from(document.querySelectorAll<SVGElement>('[data-sidebar-nav] .nav-icone svg'));
    if (!loader || !brain || !sources.length || reducedMotion.matches || !desktop.matches) return false;
    if (!brain.getBoundingClientRect().width) return false;

    const row = document.createElement('div');
    row.className = 'abertura-icones';
    const cells = sources.map((target) => {
      const cell = document.createElement('span');
      cell.className = 'abertura-icone';
      const clone = target.cloneNode(true) as SVGElement;
      clone.removeAttribute('class');
      cell.append(clone);
      row.append(cell);
      return cell;
    });
    loader.append(row);
    loader.classList.add('voando');

    const easeOut = 'cubic-bezier(0.25, 1, 0.5, 1)';
    const easeInOut = 'cubic-bezier(0.76, 0, 0.24, 1)';
    const animations: Animation[] = [];
    const content = loader.querySelector<HTMLElement>('.abertura-conteudo');
    if (content) {
      animations.push(content.animate(
        [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'scale(0.96)' }],
        { duration: 300, easing: easeOut, fill: 'forwards' },
      ));
    }
    // A entrada anima o <svg> e o voo anima a célula, para os dois não brigarem.
    cells.forEach((cell, i) => {
      animations.push(cell.firstElementChild!.animate(
        [{ opacity: 0, transform: 'scale(0.6)' }, { opacity: 1, transform: 'none' }],
        { duration: 450, delay: 200 + i * 70, easing: easeOut, fill: 'backwards' },
      ));
    });

    const land = () => {
      if (!row.isConnected) return;
      root.classList.remove('cerebro-destino');
      // O cérebro acusa o recebimento com um pulso.
      brain.classList.remove('recebeu');
      void brain.offsetWidth;
      brain.classList.add('recebeu');
      brain.addEventListener('animationend', () => brain.classList.remove('recebeu'), { once: true });
      loader.style.transition = 'none';
      loader.classList.remove('voando');
      void loader.offsetWidth;
      for (const animation of animations) animation.cancel();
      row.remove();
      loader.style.transition = '';
    };

    window.setTimeout(() => {
      // O cérebro sobe acima da tela de abertura para receber os ícones.
      root.classList.add('cerebro-destino');
      hide();
      animations.push(loader.animate(
        [{ backgroundColor: getComputedStyle(loader).backgroundColor }, { backgroundColor: 'transparent' }],
        { duration: VOO_MS * 0.8, delay: 100, easing: 'ease', fill: 'forwards' },
      ));
      const to = brain.getBoundingClientRect();
      let landed = 0;
      cells.forEach((cell, i) => {
        const from = cell.getBoundingClientRect();
        // Mira o centro do cérebro, encolhendo até sumir dentro dele.
        const scale = (to.width * 0.35) / from.width;
        const x = to.left + to.width / 2 - (from.left + (from.width * scale) / 2);
        const y = to.top + to.height / 2 - (from.top + (from.height * scale) / 2);
        const end = `translate(${x}px, ${y}px) scale(${scale})`;
        const flight = cell.animate([
          { transform: 'none', opacity: 1 },
          { opacity: 1, offset: 0.75 },
          { transform: end, opacity: 0 },
        ], { duration: VOO_MS, delay: i * 70, easing: easeInOut, fill: 'forwards' });
        animations.push(flight);
        flight.finished.then(() => {
          if (++landed === cells.length) land();
        }, land);
      });
    }, VITRINE_MS);
    return true;
  };

  const finish = () => {
    const current = revision;
    // finish roda mais de uma vez na primeira carga (load e astro:page-load);
    // o data-voo só sai quando a abertura começa, então os dois concordam.
    const flying = document.documentElement.hasAttribute('data-voo');
    window.clearTimeout(closing);
    // Sem tempo mínimo artificial: a tela só aparece depois de APARECE_APOS_MS
    // (CSS). Se já apareceu, fica um pouco mais para não piscar na saída.
    const elapsed = performance.now() - started;
    const minimum = flying
      ? ESPERA_VOO_MS
      : elapsed > APARECE_APOS_MS ? APARECE_APOS_MS + MINIMO_VISIVEL_MS : 0;
    const remaining = reducedMotion.matches ? 0 : Math.max(0, minimum - elapsed);
    closing = window.setTimeout(() => {
      if (current !== revision) return;
      if (!(flying && flyIcons())) hide();
    }, remaining);
  };

  document.addEventListener('astro:before-preparation', (event) => {
    const current = show(event.to.pathname);
    const originalLoader = event.loader;
    event.signal.addEventListener('abort', () => {
      if (current === revision) hide();
    }, { once: true });
    event.loader = async () => {
      try {
        await originalLoader();
      } catch (error) {
        if (current === revision) hide();
        throw error;
      }
    };
  });

  document.addEventListener('astro:before-swap', (event) => {
    // O próprio loader faz a transição; o snapshot nativo congela o SVG.
    void event.viewTransition.ready.catch(() => {});
    event.viewTransition.skipTransition();
  });
  document.addEventListener('astro:after-swap', () => {
    setBusy(active);
    if (active) restartAnimation();
  });
  document.addEventListener('astro:page-load', finish);
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) hide();
  });
  reducedMotion.addEventListener('change', () => {
    if (active) restartAnimation();
    else cancelAnimationFrame(animationFrame);
  });

  show();
  if (document.readyState === 'complete') finish();
  else window.addEventListener('load', finish, { once: true });
</script>
