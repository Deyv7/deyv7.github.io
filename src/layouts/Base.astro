---
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Icon from '../components/Icon.astro';
import Sidebar from '../components/Sidebar.astro';
import { profile } from '../data/profile';
import PageLoader from '../components/PageLoader.astro';
import EmailDialog from '../components/EmailDialog.astro';

interface Props {
  title?: string;
  description?: string;
  /** Caminho em /public para a imagem de compartilhamento */
  image?: string;
}

const {
  title = `${profile.name} · ${profile.headline}`,
  description = profile.description,
  image,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : null;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.headline,
  url: Astro.site?.toString(),
  address: { '@type': 'PostalAddress', addressLocality: 'Brasília', addressRegion: 'DF', addressCountry: 'BR' },
  sameAs: [profile.linkedin, profile.github],
  knowsAbout: ['Análise de Dados', 'SQL', 'Power BI', 'Python', 'Engenharia de Dados', 'Desenvolvimento Web'],
};
---

<!doctype html>
<html lang="pt-BR" data-theme="grafite" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#252525" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <!-- Aplica o tema e exibe o carregamento antes da primeira pintura. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        root.setAttribute('data-loading', '');
        try {
          const saved = localStorage.getItem('tema');
          if (saved === 'papel' || saved === 'grafite') root.dataset.theme = saved;

        } catch {}
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <ClientRouter />
  </head>
  <body class="bg-base-100 text-base-content antialiased">
    <PageLoader />
    <EmailDialog />

    <a href="#conteudo" class="btn btn-primary btn-sm fixed top-3 left-4 z-50 -translate-y-20 focus-visible:translate-y-0">
      Pular para o conteúdo
    </a>

    <div class="drawer lg:drawer-open">
      <input id="menu-lateral" type="checkbox" class="drawer-toggle" />

      <div class="drawer-content flex min-h-dvh flex-col">
        <header
          class="sticky top-0 z-30 flex items-center gap-3 border-b border-base-300 bg-base-200/95 px-4 py-2.5 backdrop-blur-md lg:hidden"
        >
          <label for="menu-lateral" class="btn btn-ghost btn-square btn-sm">
            <Icon name="menu" />
            <span class="sr-only">Abrir menu</span>
          </label>
          <a href="/" class="font-semibold tracking-tight">{profile.displayName}</a>
        </header>

        <main id="conteudo" class="flex-1">
          <slot />
        </main>
      </div>

      <div class="drawer-side z-40">
        <label for="menu-lateral" class="drawer-overlay"><span class="sr-only">Fechar menu</span></label>
        <Sidebar />
      </div>
    </div>

    <script>
      // Reaplica o tema salvo depois que o ClientRouter troca os atributos do HTML.
      document.addEventListener('astro:after-swap', () => {
        const root = document.documentElement;
        root.classList.add('js');
        try {
          const saved = localStorage.getItem('tema');
          if (saved === 'papel' || saved === 'grafite') root.dataset.theme = saved;
        } catch {}
      });

      // Revela seções quando entram na tela, uma vez por elemento
      document.addEventListener('astro:page-load', () => {
        const alvos = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.visivel)');
        if (!('IntersectionObserver' in window)) {
          for (const el of alvos) el.classList.add('visivel');
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('visivel');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        for (const el of alvos) observer.observe(el);
      });
    </script>
  </body>
</html>
