---
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Icon from '../components/Icon.astro';
import Sidebar from '../components/Sidebar.astro';
import { profile } from '../data/profile';
import PageLoader from '../components/PageLoader.astro';
import EmailDialog from '../components/EmailDialog.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { getLocale, localizePath } from '../lib/i18n';
import { getProfileData } from '../lib/profile-data';
import brainLoading from '../assets/brain-loading.svg?raw';

// O cérebro do carregamento como botão do menu. Os quadros da animação são
// tocados pelo script abaixo, que também o deixa parado com movimento reduzido.
const cerebro = brainLoading;

interface Props {
  title?: string;
  description?: string;
  /** Caminho em /public para a imagem de compartilhamento */
  image?: string;
}

const locale = getLocale(Astro.url.pathname);
const localizedProfile = getProfileData(locale).profile;
const english = locale === 'en-US';
const {
  title = `${localizedProfile.name} · ${localizedProfile.headline}`,
  description = localizedProfile.description,
  image,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : null;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: localizedProfile.headline,
  url: Astro.site?.toString(),
  address: { '@type': 'PostalAddress', addressLocality: 'Brasília', addressRegion: 'DF', addressCountry: 'BR' },
  sameAs: [profile.linkedin, profile.github],
  knowsAbout: ['Análise de Dados', 'SQL', 'Power BI', 'Python', 'Engenharia de Dados', 'Desenvolvimento Web'],
};
---

<!doctype html>
<html lang={locale} data-theme="grafite" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(localizePath(Astro.url.pathname, 'pt-BR'), Astro.site)} />
    <link rel="alternate" hreflang="en-US" href={new URL(localizePath(Astro.url.pathname, 'en-US'), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(localizePath(Astro.url.pathname, 'pt-BR'), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#252525" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={english ? 'en_US' : 'pt_BR'} />
    <meta property="og:locale:alternate" content={english ? 'pt_BR' : 'en_US'} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <!-- Aplica o tema e exibe o carregamento antes da primeira pintura. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        root.setAttribute('data-loading', '');
        try {
          const saved = localStorage.getItem('tema');
          if (saved === 'papel' || saved === 'grafite') root.dataset.theme = saved;
        } catch {}
        // Primeira página da visita, no desktop e sem pedido de menos movimento:
        // o carregamento termina com os ícones do menu voando até o cérebro.
        try {
          if (!sessionStorage.getItem('voo')) {
            sessionStorage.setItem('voo', '1');
            if (matchMedia('(min-width: 1024px)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
              root.setAttribute('data-voo', '');
            }
          }
        } catch {}
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <ClientRouter />
  </head>
  <body class="bg-base-100 text-base-content antialiased">
    <PageLoader />
    <EmailDialog />

    <a href="#conteudo" class="btn btn-primary btn-sm fixed top-3 left-4 z-50 -translate-y-20 focus-visible:translate-y-0">
      {english ? 'Skip to content' : 'Pular para o conteúdo'}
    </a>

    {/* No desktop a sidebar fica recolhida: o cérebro no canto a abre quando o
        cursor passa por ele (ou num clique), por cima do conteúdo. No celular
        segue o botão de menu do cabeçalho. */}
    <button
      type="button"
      class="cerebro-menu"
      aria-controls="menu-lateral"
      aria-expanded="false"
      aria-label={english ? 'Open menu' : 'Abrir menu'}
      data-cerebro-menu
      set:html={cerebro}
    />

    <div class="drawer">
      <input id="menu-lateral" type="checkbox" class="drawer-toggle" />

      <div class="drawer-content flex min-h-dvh flex-col">
        <header
          class="sticky top-0 z-30 flex items-center gap-3 border-b border-base-300 bg-base-200/95 px-4 py-2.5 backdrop-blur-md lg:hidden"
        >
          <label for="menu-lateral" class="btn btn-ghost btn-square btn-sm">
            <Icon name="menu" />
            <span class="sr-only">{english ? 'Open menu' : 'Abrir menu'}</span>
          </label>
          <a href={localizePath('/', locale)} class="font-semibold tracking-tight">{profile.displayName}</a>
          <div class="ml-auto"><LanguageSwitcher /></div>
        </header>

        <main id="conteudo" class="flex-1">
          <slot />
        </main>
      </div>

      <div class="drawer-side z-40">
        <label for="menu-lateral" class="drawer-overlay"><span class="sr-only">{english ? 'Close menu' : 'Fechar menu'}</span></label>
        <Sidebar />
      </div>
    </div>

    <script>
      // Reaplica o tema salvo depois que o ClientRouter troca os atributos do HTML.
      document.addEventListener('astro:after-swap', () => {
        const root = document.documentElement;
        root.classList.add('js');
        try {
          const saved = localStorage.getItem('tema');
          if (saved === 'papel' || saved === 'grafite') root.dataset.theme = saved;
        } catch {}
      });

      // Sidebar recolhida no desktop: o cérebro no canto abre ao passar o cursor
      // (ou num clique, para teclado e tela de toque) e ela fecha quando o cursor
      // sai dela. Os listeners ficam no documento e sobrevivem à troca de página.
      {
        let fechar = 0;
        const menu = () => document.getElementById('menu-lateral') as HTMLInputElement | null;
        const gatilho = () => document.querySelector<HTMLElement>('[data-cerebro-menu]');
        const definir = (aberto: boolean) => {
          window.clearTimeout(fechar);
          const toggle = menu();
          if (!toggle || toggle.checked === aberto) return;
          toggle.checked = aberto;
          toggle.dispatchEvent(new Event('change', { bubbles: true }));
        };
        const dentro = (alvo: EventTarget | null) =>
          alvo instanceof Element && !!alvo.closest('[data-cerebro-menu], .drawer-side aside');

        document.addEventListener('change', (event) => {
          if ((event.target as Element | null)?.id !== 'menu-lateral') return;
          gatilho()?.setAttribute('aria-expanded', String(menu()?.checked ?? false));
        });
        document.addEventListener('pointerover', (event) => {
          if (event.pointerType !== 'mouse') return;
          if ((event.target as Element).closest?.('[data-cerebro-menu]')) definir(true);
          else if (dentro(event.target)) window.clearTimeout(fechar);
        });
        document.addEventListener('pointerout', (event) => {
          if (event.pointerType !== 'mouse' || !menu()?.checked) return;
          if (!dentro(event.target) || dentro(event.relatedTarget)) return;
          // Um respiro antes de fechar, para o cursor poder escorregar da borda.
          window.clearTimeout(fechar);
          fechar = window.setTimeout(() => definir(false), 300);
        });
        // Só abre: com mouse o hover já abriu, e alternar aqui fecharia no clique.
        // Fecha com Esc, clicando fora ou tirando o cursor.
        document.addEventListener('click', (event) => {
          if ((event.target as Element).closest?.('[data-cerebro-menu]')) definir(true);
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && menu()?.checked) {
            definir(false);
            gatilho()?.focus();
          }
        });

        // O cérebro do canto roda sempre, menos para quem pediu menos movimento.
        // Os quadros do próprio arquivo são tocados aqui, como no PageLoader: o
        // relógio SMIL não reinicia no SVG que o ClientRouter traz na troca de
        // página, e o cérebro ficava parado fora da primeira página.
        const reduzido = window.matchMedia('(prefers-reduced-motion: reduce)');
        let faixas: { path: Element; quadros: string[]; duracao: number; atual: number }[] = [];
        let quadro = 0;
        let inicio = performance.now();
        const tocar = (agora: number) => {
          for (const faixa of faixas) {
            const decorrido = Math.max(0, agora - inicio) % faixa.duracao;
            const i = Math.floor((decorrido / faixa.duracao) * faixa.quadros.length);
            if (i === faixa.atual || !faixa.quadros[i]) continue;
            faixa.path.setAttribute('d', faixa.quadros[i]);
            faixa.atual = i;
          }
          quadro = requestAnimationFrame(tocar);
        };
        const sincronizarCerebro = () => {
          cancelAnimationFrame(quadro);
          const svg = gatilho()?.querySelector('svg');
          if (!svg) return;
          // Na primeira passada troca o SMIL pelos quadros guardados.
          for (const animacao of svg.querySelectorAll('animate[attributeName="d"]')) {
            const path = animacao.parentElement!;
            const quadros = animacao.getAttribute('values')?.split(';') ?? [];
            const duracao = parseFloat(animacao.getAttribute('dur') ?? '2.002') * 1000 || 2002;
            if (quadros.length) faixas.push({ path, quadros, duracao, atual: -1 });
            animacao.remove();
          }
          faixas = faixas.filter((faixa) => faixa.path.isConnected);
          if (reduzido.matches || document.hidden) {
            for (const faixa of faixas) if (faixa.quadros[0]) faixa.path.setAttribute('d', faixa.quadros[0]);
            return;
          }
          inicio = performance.now();
          quadro = requestAnimationFrame(tocar);
        };
        document.addEventListener('astro:page-load', sincronizarCerebro);
        document.addEventListener('visibilitychange', sincronizarCerebro);
        reduzido.addEventListener('change', sincronizarCerebro);
      }

      // Revela seções quando entram na tela, uma vez por elemento
      document.addEventListener('astro:page-load', () => {
        const alvos = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.visivel)');
        if (!('IntersectionObserver' in window)) {
          for (const el of alvos) el.classList.add('visivel');
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('visivel');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        for (const el of alvos) observer.observe(el);
      });
    </script>
  </body>
</html>
