---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { categoryLabel, getProjects, statusLabel, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[index - 1] ?? null,
      next: projects[index + 1] ?? null,
      related: projects.filter((p) => project.data.related.includes(p.id)),
    },
  }));
}

interface Props {
  project: Project;
  prev: Project | null;
  next: Project | null;
  related: Project[];
}

const { project, prev, next, related } = Astro.props;
const { Content } = await render(project);
const d = project.data;

const images = d.gallery.length > 0 ? d.gallery : d.cover ? [{ src: d.cover, alt: d.title }] : [];
const categories = d.category.map((c) => categoryLabel[c]).join(' · ');
const info = [
  { label: 'Papel', value: d.role },
  { label: 'Período', value: d.period },
  { label: 'Status', value: statusLabel[d.status] },
  { label: 'Código', value: d.private ? 'Privado' : 'Aberto no GitHub' },
];
---

<Base title={`${d.title} · Deyvid Prado`} description={d.summary}>
  <article class="pagina">
    <a
      href="/projetos/"
      class="entrada inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-base-content"
      style="--i: 0"
    >
      <Icon name="arrow-left" class="size-4" />
      Todos os projetos
    </a>

    <header class="mt-10 max-w-3xl">
      <p class="entrada text-sm text-muted" style="--i: 1">{categories}</p>
      <h1 class="mt-2 text-4xl leading-tight font-semibold sm:text-5xl" transition:name={`projeto-${project.id}`}>
        {d.title}
      </h1>
      <p class="entrada lede mt-5 text-muted" style="--i: 2">{d.summary}</p>

      {
        (d.links.demo || d.links.repo || d.links.pdf) && (
          <div class="entrada mt-8 flex flex-wrap gap-3" style="--i: 3">
            {d.links.demo && (
              <a class="btn btn-primary" href={d.links.demo} target="_blank" rel="noopener noreferrer">
                Ver no ar
                <Icon name="external" class="size-4" />
              </a>
            )}
            {d.links.repo && (
              <a
                class:list={['btn', d.links.demo ? 'btn-outline' : 'btn-primary']}
                href={d.links.repo}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name="github" class="size-4" />
                Código no GitHub
              </a>
            )}
            {d.links.pdf && (
              <a class="btn btn-outline" href={d.links.pdf} target="_blank" rel="noopener noreferrer">
                <Icon name="file" class="size-4" />
                Relatório em PDF
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      images.length > 0 && (
        <section class="entrada mt-12" style="--i: 4" aria-label="Imagens do projeto" data-gallery-root>
          <div class="carousel w-full rounded-box" data-gallery>
            {images.map((shot, i) => (
              <figure class="carousel-item w-full flex-col">
                <div class="overflow-hidden rounded-box border border-base-300 bg-base-200">
                  {shot.src.format === 'svg' ? (
                    <img
                      src={shot.src.src}
                      alt={shot.alt}
                      class="h-auto w-full"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      fetchpriority={i === 0 ? 'high' : 'auto'}
                    />
                  ) : (
                    <Image
                      src={shot.src}
                      alt={shot.alt}
                      class="h-auto w-full"
                      widths={[640, 1024, 1600, 2200]}
                      sizes="(min-width: 1120px) 65rem, 100vw"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      fetchpriority={i === 0 ? 'high' : 'auto'}
                    />
                  )}
                </div>
                <figcaption class="mt-3 text-sm text-muted">{shot.alt}</figcaption>
              </figure>
            ))}
          </div>
          {images.length > 1 && (
            <div class="mt-3 flex items-center justify-end gap-3">
              <p class="text-sm text-muted tabular-nums" data-gallery-count>
                1 / {images.length}
              </p>
              <div class="join">
                <button type="button" class="btn btn-sm join-item" data-gallery-prev aria-label="Imagem anterior">
                  <Icon name="arrow-left" class="size-4" />
                </button>
                <button type="button" class="btn btn-sm join-item" data-gallery-next aria-label="Próxima imagem">
                  <Icon name="arrow-right" class="size-4" />
                </button>
              </div>
            </div>
          )}
        </section>
      )
    }

    {
      d.metrics.length > 0 && (
        <ul class="mt-14 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-base-300 pt-8 lg:grid-cols-4" data-reveal>
          {d.metrics.map((metric) => (
            <li>
              <span class="block text-3xl font-semibold tracking-tight tabular-nums">{metric.value}</span>
              <span class="mt-1 block text-sm text-muted">{metric.label}</span>
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-14 grid gap-14 lg:grid-cols-[1fr_20rem] lg:gap-16">
      <div class="prose-projeto" data-reveal>
        <Content />
      </div>

      <aside class="space-y-10" data-reveal style="--i: 1">
        <section aria-labelledby="info-title">
          <h2 id="info-title" class="text-lg font-semibold">Informações gerais</h2>
          <dl class="mt-3 divide-y divide-base-300 border-y border-base-300 text-[0.9375rem]">
            {
              info.map((item) => (
                <div class="grid grid-cols-[5.5rem_1fr] gap-4 py-3">
                  <dt class="text-muted">{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section aria-labelledby="tech-title">
          <h2 id="tech-title" class="text-lg font-semibold">Tecnologias</h2>
          <ul class="mt-3 divide-y divide-base-300 border-y border-base-300">
            {
              d.stack.map((tech) => (
                <li class="py-3">
                  <p class="font-medium">{tech.name}</p>
                  <p class="mt-0.5 text-sm text-muted">{tech.role}</p>
                </li>
              ))
            }
          </ul>
        </section>

        {
          related.length > 0 && (
            <section aria-labelledby="relacionados-title">
              <h2 id="relacionados-title" class="text-lg font-semibold">
                {related.length === 1 ? 'Projeto relacionado' : 'Projetos relacionados'}
              </h2>
              <ul class="mt-3 space-y-2">
                {related.map((item) => (
                  <li>
                    <a class="inline-flex items-center gap-1.5 text-brand hover:underline" href={`/projetos/${item.id}/`}>
                      {item.data.title}
                      <Icon name="arrow-right" class="size-4" />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </aside>
    </div>

    <nav class="mt-20 grid gap-6 border-t border-base-300 pt-8 sm:grid-cols-2" aria-label="Outros projetos" data-reveal>
      {
        prev ? (
          <a href={`/projetos/${prev.id}/`} class="group">
            <span class="flex items-center gap-1.5 text-sm text-muted">
              <Icon name="arrow-left" class="size-4" />
              Anterior
            </span>
            <span class="mt-1 block font-semibold transition-colors group-hover:text-brand">{prev.data.title}</span>
          </a>
        ) : (
          <span class="hidden sm:block" />
        )
      }
      {
        next && (
          <a href={`/projetos/${next.id}/`} class="group sm:text-right">
            <span class="flex items-center gap-1.5 text-sm text-muted sm:justify-end">
              Próximo
              <Icon name="arrow-right" class="size-4" />
            </span>
            <span class="mt-1 block font-semibold transition-colors group-hover:text-brand">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-gallery-root]')) {
      const track = root.querySelector<HTMLElement>('[data-gallery]');
      const count = root.querySelector<HTMLElement>('[data-gallery-count]');
      if (!track) continue;
      const total = track.children.length;
      const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const go = (direction: number) =>
        track.scrollBy({ left: direction * track.clientWidth, behavior: smooth ? 'smooth' : 'auto' });

      root.querySelector('[data-gallery-prev]')?.addEventListener('click', () => go(-1));
      root.querySelector('[data-gallery-next]')?.addEventListener('click', () => go(1));
      track.addEventListener(
        'scroll',
        () => {
          if (!count) return;
          const index = Math.round(track.scrollLeft / track.clientWidth);
          count.textContent = `${Math.min(index + 1, total)} / ${total}`;
        },
        { passive: true },
      );
    }
  });
</script>
