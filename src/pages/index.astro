---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HeroSmoke from '../components/HeroSmoke.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/projects';
import { getProfileData } from '../lib/profile-data';
import { getLocale, localizePath } from '../lib/i18n';

const locale = getLocale(Astro.url.pathname);
const english = locale === 'en-US';
const { profile } = getProfileData(locale);
const projects = (await getProjects(locale)).slice(0, 3);
---

<Base>
  <div data-home>
  <section
    data-home-hero
    class="capa relative flex min-h-[calc(100svh-3.25rem)] items-center justify-center overflow-hidden px-6 py-20 text-center lg:min-h-svh"
  >
    {/* svh, não dvh: no iPhone o dvh muda quando a barra do Safari some na
        rolagem, a capa mudava de altura e o canvas da fumaça piscava. */}
    <HeroSmoke />
    <div class="relative max-w-3xl">
      {/* inline-block: o fundo do destaque entra na altura da linha; inline, o
          padding vazava para a linha de baixo e tampava o "VINDO" no celular.
          O nowrap impede a quebra no hífen de "BEM-VINDO!". */}
      <h1 class="text-4xl leading-tight font-bold tracking-tight sm:text-6xl" data-home-intro>
        <span class="inline-block bg-primary px-4 py-1 text-primary-content">{english ? 'HELLO' : 'SEJA'}</span>
        <span class="whitespace-nowrap">{english ? '& WELCOME!' : 'BEM-VINDO!'}</span>
      </h1>

      <p class="mt-6 text-xl sm:text-2xl" data-home-intro>
        {english ? 'I’m' : 'Eu sou'}
        <span class="sr-only">{profile.roles.join(', ')}</span>
        <span class="text-rotate duration-9000 ml-1 align-bottom font-semibold text-brand" aria-hidden="true">
          <span>
            {profile.roles.map((role) => <span>{role}</span>)}
          </span>
        </span>
      </p>

      <p class="mx-auto mt-6 max-w-xl text-muted" data-home-intro>{profile.description}</p>

      <div class="mt-10 flex flex-wrap justify-center gap-3" data-home-intro>
        <a href={localizePath('/projetos/', locale)} class="btn btn-primary">{english ? 'View portfolio' : 'Ver portfólio'}</a>
        <a href={localizePath('/curriculo/', locale)} class="btn btn-outline">
          <Icon name="arrow-right" class="size-4" />
          {english ? 'View resume' : 'Ver currículo'}
        </a>
      </div>
    </div>

    <a
      href="#projetos-selecionados"
      class="absolute bottom-8 left-1/2 -translate-x-1/2 text-muted transition-colors hover:text-base-content"
      aria-label={english ? 'Go to selected projects' : 'Ir para projetos selecionados'}
    >
      <Icon name="arrow-down" class="size-6" />
    </a>
  </section>
  <section id="projetos-selecionados" class="border-t border-base-300" aria-labelledby="projetos-titulo">
    <div class="pagina">
      <header class="mb-8 flex flex-wrap items-end justify-between gap-5">
        <div>
          <p class="mb-2 text-xs font-semibold tracking-[0.14em] text-brand uppercase">{english ? 'Data, software, and AI' : 'Dados, software e IA'}</p>
          <h2 id="projetos-titulo" class="text-2xl font-bold tracking-tight sm:text-3xl">{english ? 'Selected projects' : 'Projetos selecionados'}</h2>
        </div>
        <a href={localizePath('/projetos/', locale)} class="btn btn-outline btn-sm">
          {english ? 'View all projects' : 'Ver todos os projetos'} <Icon name="arrow-right" class="size-4" />
        </a>
      </header>
      <ul class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {projects.map((project) => (
          <li data-home-project><ProjectCard project={project} /></li>
        ))}
      </ul>
    </div>
  </section>
  </div>
</Base>

<script>
  import '../scripts/home-motion';
</script>
