---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HomeNetwork from '../components/HomeNetwork.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/projects';
import { profile } from '../data/profile';

const projects = (await getProjects()).slice(0, 3);
---

<Base>
  <div data-home>
  <section
    data-home-hero
    class="capa relative flex min-h-[calc(100dvh-3.25rem)] items-center justify-center overflow-hidden px-6 py-20 text-center lg:min-h-dvh"
  >
    <HomeNetwork />
    <div class="relative max-w-3xl">
      <h1 class="text-4xl font-bold tracking-tight sm:text-6xl" data-home-intro>
        <span class="bg-primary px-4 py-2 text-primary-content">SEJA</span> BEM-VINDO!
      </h1>

      <p class="mt-6 text-xl sm:text-2xl" data-home-intro>
        Eu sou
        <span class="sr-only">{profile.roles.join(', ')}</span>
        <span class="text-rotate duration-9000 ml-1 align-bottom font-semibold text-brand" aria-hidden="true">
          <span>
            {profile.roles.map((role) => <span>{role}</span>)}
          </span>
        </span>
      </p>

      <p class="mx-auto mt-6 max-w-xl text-muted" data-home-intro>{profile.description}</p>

      <div class="mt-10 flex flex-wrap justify-center gap-3" data-home-intro>
        <a href="/projetos/" class="btn btn-primary">Ver portfólio</a>
        {
          profile.cvUrl && (
            <a href={profile.cvUrl} class="btn btn-outline" download>
              <Icon name="download" class="size-4" />
              Baixar CV
            </a>
          )
        }
      </div>
    </div>

    <a
      href="#projetos-selecionados"
      class="absolute bottom-8 left-1/2 -translate-x-1/2 text-muted transition-colors hover:text-base-content"
      aria-label="Ir para projetos selecionados"
    >
      <Icon name="arrow-down" class="size-6" />
    </a>
  </section>
  <section id="projetos-selecionados" class="border-t border-base-300" aria-labelledby="projetos-titulo">
    <div class="pagina">
      <header class="mb-8 flex flex-wrap items-end justify-between gap-5">
        <div>
          <p class="mb-2 text-xs font-semibold tracking-[0.14em] text-brand uppercase">Dados, software e IA</p>
          <h2 id="projetos-titulo" class="text-2xl font-bold tracking-tight sm:text-3xl">Projetos selecionados</h2>
        </div>
        <a href="/projetos/" class="btn btn-outline btn-sm">
          Ver todos os projetos <Icon name="arrow-right" class="size-4" />
        </a>
      </header>
      <ul class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {projects.map((project) => (
          <li data-home-project><ProjectCard project={project} /></li>
        ))}
      </ul>
    </div>
  </section>
  </div>
</Base>

<script>
  import '../scripts/home-motion';
</script>
