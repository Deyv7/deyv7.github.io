---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import TituloSecao from '../components/TituloSecao.astro';
import { highlights, languages, profile } from '../data/profile';

const informacoes = [
  { rotulo: 'Nome', valor: profile.name },
  { rotulo: 'E-mail', valor: profile.email, href: `mailto:${profile.email}` },
  { rotulo: 'Localização', valor: 'Brasília, DF' },
  { rotulo: 'Disponibilidade', valor: profile.workModes },
  { rotulo: 'Idiomas', valor: languages.map((lang) => lang.name).join(' · ') },
];
---

<Base title={`Sobre · ${profile.name}`} description="Quem é Deyvid Prado: analista de dados e desenvolvedor em Brasília.">
  <div class="pagina">
    <TituloSecao destaque="SOBRE" resto="MIM" subtitulo="Quem sou eu" />

    <div class="grid gap-12 lg:grid-cols-[1fr_19rem] lg:gap-16">
      <div data-reveal>
        <h2 class="flex items-center gap-2 text-sm font-bold tracking-[0.14em] uppercase">
          <Icon name="user" class="size-4 text-brand" />
          Sobre
        </h2>
        <div class="lede mt-6 space-y-4 text-muted">
          <p>
            Sou Analista de Dados e desenvolvedor, de Brasília. Comecei no TRE-DF automatizando rotinas com Python e
            montando relatórios que a gestão usava para decidir. Em paralelo, co-fundei o E-Habilita, que hoje está no ar
            com pagamentos, rastreamento das aulas e IA.
          </p>
          <p>
            Gosto de problema que termina em decisão: a pergunta certa, a query certa e um painel que explica o resultado
            sem precisar de legenda. No desenvolvimento, levo a mesma ideia até o fim, com banco modelado, integrações e
            o produto no ar.
          </p>
          <p>
            Uso IA no dia a dia como ferramenta de análise e automação, e também dentro dos produtos, como no agente que
            atende e valida cadastros no E-Habilita.
          </p>
        </div>
      </div>

      <aside data-reveal style="--i: 1">
        <h2 class="flex items-center gap-2 text-sm font-bold tracking-[0.14em] uppercase">
          <span class="h-4 w-0.5 bg-primary"></span>
          Informações pessoais
        </h2>
        <dl class="mt-6 divide-y divide-base-300 border-y border-base-300 text-[0.9375rem]">
          {
            informacoes.map((item) => (
              <div class="grid grid-cols-[7.5rem_1fr] gap-3 py-3">
                <dt class="text-muted">{item.rotulo}</dt>
                <dd class="break-words">
                  {item.href ? (
                    <a class="transition-colors hover:text-brand" href={item.href}>
                      {item.valor}
                    </a>
                  ) : (
                    item.valor
                  )}
                </dd>
              </div>
            ))
          }
        </dl>

        {
          profile.cvUrl && (
            <a href={profile.cvUrl} class="btn btn-outline btn-sm mt-6" download>
              <Icon name="download" class="size-4" />
              Baixar CV
            </a>
          )
        }
      </aside>
    </div>

    <section class="mt-16" aria-labelledby="numeros-titulo" data-reveal>
      <h2 id="numeros-titulo" class="flex items-center gap-2 text-sm font-bold tracking-[0.14em] uppercase">
        <Icon name="star" class="size-4 text-brand" />
        Resultados em números
      </h2>

      <div
        class="stats stats-vertical mt-6 w-full rounded-box border border-base-300 bg-base-200 lg:stats-horizontal lg:auto-cols-fr"
      >
        {
          highlights.map((item) => (
            <div class="stat gap-y-1 px-6 py-5">
              <a href={item.href} class="stat-title text-sm text-muted transition-colors hover:text-brand">
                {item.source}
              </a>
              <p class="stat-value text-3xl font-semibold tracking-tight tabular-nums">{item.value}</p>
              <p class="stat-desc text-sm whitespace-normal text-muted">{item.label}</p>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Base>
