---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import TituloSecao from '../components/TituloSecao.astro';
import { profile } from '../data/profile';

const { dados, dev } = profile.targetRoles;
const lista = (itens: readonly string[]) => `${itens.slice(0, -1).join(', ')} ou ${itens.at(-1)}`;
const areas = [
  { area: 'Dados', cargos: lista(dados) },
  { area: 'Desenvolvimento', cargos: lista(dev) },
];
---

<Base title={`Contato · ${profile.name}`} description="Fale com Deyvid Prado por e-mail ou LinkedIn.">
  <div class="pagina">
    <TituloSecao destaque="CONTATO" subtitulo="Vamos conversar" />

    <div class="grid gap-12 lg:grid-cols-[1fr_19rem] lg:gap-16">
      <div data-reveal>
        <p class="lede">
          Estou aberto a vagas de dados e de desenvolvimento, no modelo {profile.workModes}. O caminho mais rápido é e-mail ou
          LinkedIn.
        </p>

        <dl class="mt-8 divide-y divide-base-300 border-y border-base-300">
          {
            areas.map((item) => (
              <div class="grid gap-1 py-4 sm:grid-cols-[11rem_1fr] sm:gap-8">
                <dt class="font-semibold">{item.area}</dt>
                <dd class="text-muted">{item.cargos}</dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-3">
          <a
            href={`mailto:${profile.email}`}
            class="text-2xl font-semibold tracking-tight break-all underline decoration-base-300 decoration-2 underline-offset-8 transition-colors hover:decoration-primary sm:text-3xl"
          >
            {profile.email}
          </a>
          <button type="button" class="btn btn-ghost btn-sm" data-copy={profile.email}>
            <Icon name="copy" class="size-4" />
            Copiar
          </button>
        </div>

        <ul class="mt-8 flex flex-wrap gap-3">
          <li>
            <a href={profile.linkedin} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
              <Icon name="linkedin" class="size-4" />
              LinkedIn
            </a>
          </li>
          <li>
            <a href={profile.github} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
              <Icon name="github" class="size-4" />
              GitHub
            </a>
          </li>
          {
            profile.cvUrl && (
              <li>
                <a href={profile.cvUrl} class="btn btn-outline" download>
                  <Icon name="download" class="size-4" />
                  Baixar CV
                </a>
              </li>
            )
          }
        </ul>
      </div>

      <aside data-reveal style="--i: 1">
        <h2 class="flex items-center gap-2 text-sm font-bold tracking-[0.14em] uppercase">
          <span class="h-4 w-0.5 bg-primary"></span>
          Onde me encontrar
        </h2>
        <dl class="mt-6 divide-y divide-base-300 border-y border-base-300 text-[0.9375rem]">
          <div class="grid grid-cols-[7.5rem_1fr] gap-3 py-3">
            <dt class="text-muted">Base</dt>
            <dd>Brasília, DF</dd>
          </div>
          <div class="grid grid-cols-[7.5rem_1fr] gap-3 py-3">
            <dt class="text-muted">Modelo</dt>
            <dd>{profile.workModes}</dd>
          </div>
          <div class="grid grid-cols-[7.5rem_1fr] gap-3 py-3">
            <dt class="text-muted">Resposta</dt>
            <dd>E-mail ou LinkedIn</dd>
          </div>
        </dl>
      </aside>
    </div>
  </div>

  <div class="toast toast-end toast-bottom z-50" aria-live="polite">
    <div class="alert alert-success" data-toast hidden>
      <Icon name="check" class="size-4" />
      <span>E-mail copiado</span>
    </div>
  </div>
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    const toast = document.querySelector<HTMLElement>('[data-toast]');
    let timer: number | undefined;

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? '');
        } catch {
          return;
        }
        if (!toast) return;
        toast.hidden = false;
        window.clearTimeout(timer);
        timer = window.setTimeout(() => (toast.hidden = true), 2500);
      });
    }
  });
</script>
