---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import TituloSecao from '../components/TituloSecao.astro';
import { getProfileData } from '../lib/profile-data';
import { getLocale } from '../lib/i18n';

const locale = getLocale(Astro.url.pathname);
const english = locale === 'en-US';
const { profile } = getProfileData(locale);
const { dados, dev } = profile.targetRoles;
const lista = (itens: readonly string[]) => `${itens.slice(0, -1).join(', ')} ${english ? 'or' : 'ou'} ${itens.at(-1)}`;
const areas = [
  { area: english ? 'Data' : 'Dados', cargos: lista(dados) },
  { area: english ? 'Development' : 'Desenvolvimento', cargos: lista(dev) },
];
---

<Base title={`${english ? 'Contact' : 'Contato'} · ${profile.name}`} description={english ? 'Get in touch with Deyvid Prado by email or LinkedIn.' : 'Fale com Deyvid Prado por e-mail ou LinkedIn.'}>
  <div class="pagina">
    <TituloSecao destaque={english ? 'CONTACT' : 'CONTATO'} subtitulo={english ? 'Let’s talk' : 'Vamos conversar'} />

    <div class="grid gap-12 lg:grid-cols-[1fr_19rem] lg:gap-16">
      <div data-reveal>
        <p class="lede">
          {english
            ? `I’m open to data and development roles: ${profile.workModes}. The quickest way to reach me is by email or LinkedIn.`
            : `Estou aberto a vagas de dados e de desenvolvimento, no modelo ${profile.workModes}. O caminho mais rápido é e-mail ou LinkedIn.`}
        </p>

        <dl class="mt-8 divide-y divide-base-300 border-y border-base-300">
          {
            areas.map((item) => (
              <div class="grid gap-1 py-4 sm:grid-cols-[11rem_1fr] sm:gap-8">
                <dt class="font-semibold">{item.area}</dt>
                <dd class="text-muted">{item.cargos}</dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-3">
          <a
            href={`mailto:${profile.email}`}
            data-email-trigger aria-haspopup="dialog" aria-controls="email-dialog"
            class="text-2xl font-semibold tracking-tight break-all underline decoration-base-300 decoration-2 underline-offset-8 transition-colors hover:decoration-primary sm:text-3xl"
          >
            {profile.email}
          </a>
          <button type="button" class="btn btn-ghost btn-sm" data-copy={profile.email}>
            <Icon name="copy" class="size-4" />
            {english ? 'Copy' : 'Copiar'}
          </button>
        </div>

        <ul class="mt-8 flex flex-wrap gap-3">
          <li>
            <a href={profile.linkedin} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
              <Icon name="linkedin" class="size-4" />
              LinkedIn
            </a>
          </li>
          <li>
            <a href={profile.github} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
              <Icon name="github" class="size-4" />
              GitHub
            </a>
          </li>
          {
            profile.cvUrl && (
              <li>
                <a href={profile.cvUrl} class="btn btn-outline" target="_blank" rel="noopener noreferrer" aria-label={english ? 'View resume (PDF in Portuguese, opens in a new tab)' : 'Ver currículo (PDF, abre em uma nova aba)'}>
                  <Icon name="external" class="size-4" />
                  {english ? 'View resume (PT-BR)' : 'Ver currículo'}
                </a>
              </li>
            )
          }
        </ul>
      </div>

      <aside data-reveal style="--i: 1">
        <h2 class="flex items-center gap-2 text-sm font-bold tracking-[0.14em] uppercase">
          <span class="h-4 w-0.5 bg-primary"></span>
          {english ? 'Where to find me' : 'Onde me encontrar'}
        </h2>
        <dl class="mt-6 divide-y divide-base-300 border-y border-base-300 text-[0.9375rem]">
          <div class="grid grid-cols-[7.5rem_1fr] gap-3 py-3">
            <dt class="text-muted">{english ? 'Based in' : 'Base'}</dt>
            <dd>Brasília, DF</dd>
          </div>
          <div class="grid grid-cols-[7.5rem_1fr] gap-3 py-3">
            <dt class="text-muted">{english ? 'Work setup' : 'Modelo'}</dt>
            <dd>{profile.workModes}</dd>
          </div>
          <div class="grid grid-cols-[7.5rem_1fr] gap-3 py-3">
            <dt class="text-muted">{english ? 'Reach me' : 'Resposta'}</dt>
            <dd>{english ? 'Email or LinkedIn' : 'E-mail ou LinkedIn'}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </div>

  <div class="toast toast-end toast-bottom z-50" aria-live="polite">
    <div class="alert alert-success" data-toast hidden>
      <Icon name="check" class="size-4" />
      <span>{english ? 'Email copied' : 'E-mail copiado'}</span>
    </div>
  </div>
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    const toast = document.querySelector<HTMLElement>('[data-toast]');
    let timer: number | undefined;

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? '');
        } catch {
          return;
        }
        if (!toast) return;
        toast.hidden = false;
        window.clearTimeout(timer);
        timer = window.setTimeout(() => (toast.hidden = true), 2500);
      });
    }
  });
</script>
