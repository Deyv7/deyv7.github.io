---
import Base from '../layouts/Base.astro';
import TituloSecao from '../components/TituloSecao.astro';
---

<Base title="Página não encontrada · Deyvid Prado" description="Esta página não existe.">
  <div class="pagina">
    <TituloSecao destaque="ERRO" resto="404" subtitulo="Página não encontrada" />
    <p class="lede text-muted">O endereço pode ter mudado. Os trabalhos continuam na página de portfólio.</p>
    <a href="/projetos/" class="btn btn-primary mt-8">Ver portfólio</a>
  </div>
</Base>
